{
  "id": "/",
  "name": "AllConverter.tools — Free Online Tools",
  "short_name": "AllConverter",
  "description": "250+ free online tools for PDF, images, text, developer utilities, and more. Files stay on your device.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0A0A0A",
  "theme_color": "#5546F0",
  "categories": ["utilities", "productivity"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "shortcuts": [
    { "name": "Open a file", "url": "/open/", "description": "Pick a file and choose what to do with it" },
    { "name": "Compress PDF", "url": "/tools/pdf-compressor/" },
    { "name": "Compress image", "url": "/tools/image-compressor/" },
    { "name": "Photo & signature resizer", "url": "/tools/photo-signature-resizer/" }
  ],
  "share_target": {
    "action": "/share-target/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "files", "accept": ["application/pdf", ".pdf", "image/*", "audio/*"] }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/open/",
      "accept": {
        "application/pdf": [".pdf"],
        "image/jpeg": [".jpg", ".jpeg"],
        "image/png": [".png"],
        "image/webp": [".webp"]
      }
    }
  ]
}
